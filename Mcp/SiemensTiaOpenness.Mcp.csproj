<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TiaIncludePlcApi>true</TiaIncludePlcApi></PropertyGroup>
  <Import Project="../build/TiaPortal.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>SiemensTiaOpenness.Mcp</AssemblyName>
    <Version>0.6.0</Version>
    <OutputPath>bin/$(Configuration)/$(TiaPortalVersion)/</OutputPath>
    <IntermediateOutputPath>obj/$(TiaPortalVersion)/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml.Linq" />
    <Compile Include="../TiaPortalAssemblyResolver.cs" Link="Shared/TiaPortalAssemblyResolver.cs" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
