<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TiaIncludePlcApi>true</TiaIncludePlcApi></PropertyGroup>
  <Import Project="../build/TiaPortal.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>SiemensMCPServer.Mcp</AssemblyName>
    <Version>0.15.0</Version>
    <OutputPath>bin/$(Configuration)/$(TiaPortalVersion)/</OutputPath>
    <IntermediateOutputPath>obj/$(TiaPortalVersion)/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../plugin/*.md" LogicalName="SiemensWorkflow/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../plugin/skills/**/SKILL.md" LogicalName="SiemensWorkflow/skills/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Analysis/*.cs" Link="Analysis/%(Filename)%(Extension)"/>
    <Compile Include="../Extensions/ExtensionContract.cs" Link="Extensions/ExtensionContract.cs" />
    <Compile Include="../Extensions/FeatureOperations.cs" Link="Extensions/FeatureOperations.cs" />
    <Compile Include="../Extensions/ComfortPackage.cs" Link="Extensions/ComfortPackage.cs" />
    <Compile Include="../Extensions/HmiAnalysisOperations.cs" Link="Extensions/HmiAnalysisOperations.cs" />
    <Compile Include="../Extensions/PlcInspectionOperations.cs" Link="Extensions/PlcInspectionOperations.cs" />
    <Compile Include="../Extensions/LibraryInspectionOperations.cs" Link="Extensions/LibraryInspectionOperations.cs" />
    <Compile Include="../Extensions/ProjectTextOperations.cs" Link="Extensions/ProjectTextOperations.cs" />
    <Compile Include="../Extensions/ProjectTranslationOperations.cs" Link="Extensions/ProjectTranslationOperations.cs" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.IO.Compression" />
    <Compile Include="../TiaPortalAssemblyResolver.cs" Link="Shared/TiaPortalAssemblyResolver.cs" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="BuildFeatureExtensions" AfterTargets="Build" Condition="'$(StageFeatureExtensions)' != 'false'">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\build\Build-Extensions.ps1&quot; -Destination &quot;$(TargetDir)extensions&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
  <Target Name="PublishFeatureExtensions" AfterTargets="Publish" Condition="'$(StageFeatureExtensions)' != 'false'">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\build\Build-Extensions.ps1&quot; -Destination &quot;$(PublishDir)extensions&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
</Project>
