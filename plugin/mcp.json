{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "siemens-mcp-server": {
      "type": "stdio",
      "command": "py",
      "args": [
        "-3.13",
        "-B",
        "framework/launch.py"
      ],
      "cwd": ".",
      "env": {
        "PYTHONNOUSERSITE": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": ""
      }
    }
  }
}
