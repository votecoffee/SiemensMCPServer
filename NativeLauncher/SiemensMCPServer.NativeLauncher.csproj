<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion><Nullable>annotations</Nullable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>SiemensMCPServer.NativeLauncher</AssemblyName>
    <AppConfig>../App.config</AppConfig><ApplicationManifest>../Shared/WindowsLongPaths.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>native-launcher-contract-1</InformationalVersion>
    <EnableSourceLink>false</EnableSourceLink><EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <Deterministic>true</Deterministic><PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/source</PathMap>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Text.Json" Version="10.0.10" /></ItemGroup>
</Project>
